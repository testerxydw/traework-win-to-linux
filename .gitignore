# ===== 构建产物与大文件（由 setup.sh 生成，不纳入版本控制） =====

# deb 打包目录中的大文件（Chromium 运行时、应用资源、原生库）
deb-pkg/opt/trae-solo-cn/*
# 保留启动脚本
!deb-pkg/opt/trae-solo-cn/trae-solo-cn

# DEBIAN 自动生成的校验文件（build.sh 会重新生成）
deb-pkg/DEBIAN/md5sums

# 构建输出的 deb 包（约 500MB/个）
*.deb
*.uab
*.exe

# 源材料（需自行下载）
extracted/
extracted-new/
workbuddy-build/
.traecode-extract/


# 自编译的 innoextract（用于解析 Inno Setup 6.4+ 安装包）
.innoextract-src/
.innoextract-src/build
shop-screenshots/
# 图标缓存
deb-pkg/usr/share/icons/

# IDE / 工具数据
.codebuddy/
__pycache__/

# pica 打包工作目录（保留配置，排除生成内容）
pica-work/*
!pica-work/package.yaml

# WorkBuddy 移植产物与源材料
workbuddy-build/**/*.deb
# 但保留构建脚本（拆包打包流程，可复用）
!workbuddy-build/scripts/
!workbuddy-build/scripts/**/*.sh

# WorkBuddy 运行时缓存（解包自社区 deb，约 200M+）
workbuddy-build/runtime-cache/
workbuddy-build/wb_extract/
